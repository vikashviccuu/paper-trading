# ---- Server ----
PORT=4000
NODE_ENV=development
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# ---- Admin auth (fully separate from regular user JWT_SECRET above) ----
ADMIN_JWT_SECRET=change_this_to_a_different_long_random_string
ADMIN_JWT_EXPIRES_IN=12h
# Used once by `npm run seed:admin` to create the first admin account -
# leave blank afterwards, it's not read again.
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change_this_before_seeding
ADMIN_SEED_NAME=Platform Admin

# ---- Database ----
DATABASE_URL="postgresql://postgres:root@127.0.0.1:5433/paper_trading?schema=public"

# ---- Redis (tick cache / pub-sub for WebSocket fan-out) ----
REDIS_URL="redis://localhost:6379"

# ---- Active broker used for market data / instrument master ----
# One of: ZERODHA | UPSTOX | ANGELONE | MOCK
BROKER_PROVIDER=ZERODHA

# ---- Zerodha Kite Connect ----
# Get these from https://developers.kite.trade after creating an app (paid, ~Rs 2000/month)
KITE_API_KEY=jfwd2gvwal8pq0rp
KITE_API_SECRET=a5j4kdo7zr2u57zfpjan8plmctdjun4t
KITE_ACCESS_TOKEN=

# ---- Upstox ----
# Get these from https://account.upstox.com/developer/apps (free)
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:4000/api/broker/upstox/callback
UPSTOX_ACCESS_TOKEN=

# ---- Angel One SmartAPI ----
# Get these from https://smartapi.angelbroking.com (free)
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

# ---- Virtual trading defaults ----
DEFAULT_VIRTUAL_CASH=1000000
INTRADAY_SQUAREOFF_TIME=15:20
EQUITY_INTRADAY_MARGIN_PCT=0.20
FNO_MARGIN_PCT=0.12
# Market close time used to pin computed end dates for WEEKLY/MONTHLY/
# HALF_YEARLY/YEARLY contests, and to trigger end-of-contest auto square-off.
CONTEST_MARKET_CLOSE_TIME=15:30

# ---- KYC / bank account verification (profile page) ----
# One of: SETU | CASHFREE | MOCK
KYC_PROVIDER=MOCK

# ---- Setu (https://setu.co/data/kyc/) ----
# Get these from the Setu Bridge merchant console after creating a PAN
# Verification + Bank Account Verification (Penny Drop) product instance.
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=
SETU_PRODUCT_INSTANCE_ID=

# ---- Cashfree Verification Suite (https://www.cashfree.com/verification-suite/) ----
# Get these from the Cashfree merchant dashboard -> Verification Suite -> Developers -> API Keys.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=

# ---- KYC document uploads ----
KYC_UPLOAD_DIR=./uploads/kyc
KYC_MAX_UPLOAD_MB=5

# ---- Phone OTP verification ----
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ---- Contest prize payouts (see docs/PRIZES_AND_PAYOUTS.md) ----
# Flat TDS rate deducted from every contest prize award, no minimum
# threshold - matches Section 194BA / Section 393(3) "net winnings from
# online games" rule as of Aug 2026. Do not change without legal sign-off.
TDS_RATE_PCT=30

# One of: CASHFREE | MOCK
PAYOUT_PROVIDER=MOCK

# ---- Cashfree Payouts (https://www.cashfree.com/docs/api-reference/payouts/overview) ----
# Separate API credentials from the Verification Suite ones above, even
# though both are Cashfree products. Get these from the Cashfree merchant
# dashboard -> Payouts -> Developers -> API Keys.
CASHFREE_PAYOUT_CLIENT_ID=
CASHFREE_PAYOUT_CLIENT_SECRET=

# ---- Live (real-money) trading (see docs/LIVE_TRADING.md) - READ FIRST ----
# Master kill switch, defaults off. Do not flip to true without reading
# docs/LIVE_TRADING.md end to end - this enables real order placement with
# real money via broker APIs.
LIVE_TRADING_ENABLED=false

# SELF_CUSTODY (implemented) - orders execute on each user's own linked
# broker account. PLATFORM_POOLED is NOT implemented - selecting it fails
# closed on every order. See docs/LIVE_TRADING.md#execution-model.
LIVE_EXECUTION_MODE=SELF_CUSTODY

# ---- ICICI Direct Breeze Connect (live order placement only) ----
# Get these from https://api.icicidirect.com after registering an app.
ICICI_BREEZE_API_KEY=
ICICI_BREEZE_API_SECRET=

# ---- Live trading default risk controls ----
LIVE_DEFAULT_DAILY_ORDER_LIMIT=50
LIVE_DEFAULT_MAX_ORDER_VALUE=50000
LIVE_ORDER_2FA_VALIDITY_MINUTES=5

# ---- MSG91 OTP Gateway ----
MSG91_AUTHKEY=
MSG91_TOKEN=
MSG91_WIDGET_ID=
MSG91_TEMPLATE_ID=

# ---- Test Mode Demo Codes ----
ENABLE_DEMO_OTP=true

