{
  "name": "paper-trading-backend",
  "version": "1.0.0",
  "description": "Multi-broker paper trading platform backend (equity + F&O virtual trading engine)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed:admin": "ts-node prisma/seedAdmin.ts",
    "generate-kite-token": "ts-node scripts/generateKiteToken.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "axios": "^1.7.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "kiteconnect": "^4.0.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "otplib": "^13.0.1",
    "socket.io": "^4.7.5",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.15",
    "@types/node-cron": "^3.0.11",
    "@types/ws": "^8.5.12",
    "prisma": "^5.18.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
}
